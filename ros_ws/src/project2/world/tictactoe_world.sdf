<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="tictactoe_world">
    <physics name='1ms' type='ignored'>
      <max_step_size>0.005</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>
    <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system'/>
    <plugin name='gz::sim::systems::Contact' filename='gz-sim-contact-system'/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!--
      로봇은 (0.3, -0.05, 0)에 스폰한다 (launch 파일 참고).
      기구학 도달범위 계산 결과, 로봇 base 기준 수평거리 20~300mm / 높이
      90~230mm 구간이 "그리퍼를 수직에서 30도 이내로 기울여 접근 가능한"
      영역이었다. 그래서 원래 테이블(z=-0.025)/보드(z=0.03) 높이를
      그대로 쓰면 로봇 바로 앞(z~0)이라 도달 불가 사각지대에 걸린다.
      +0.20m 만큼 받침대로 들어올려서 보드 표면이 로봇 base 기준
      z=0.23m 근처(적정 구간)에 오도록 수정했다.
    -->
    <model name="tictactoe_table">
      <static>true</static>
      <pose>0.3 0.0 0.175 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 0.8 0.05</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 0.8 0.05</size></box></geometry>
          <material>
            <ambient>0.6 0.4 0.2 1</ambient>
            <diffuse>0.6 0.4 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 받침 기둥 (테이블을 z=0.15m까지 들어올리는 지지대, 시각/충돌용) -->
    <model name="table_stand">
      <static>true</static>
      <pose>0.3 0.0 0.075 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.3 0.3 0.15</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.3 0.15</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="tictactoe_board">
      <static>true</static>
      <pose>0.3 0.0 0.23 0 0 0</pose>

      <link name="base_link">
        <collision name="collision">
          <geometry><box><size>0.3 0.3 0.01</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.3 0.01</size></box></geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="cell_0_0">
        <pose>-0.08 0.08 0.006 0 0 0</pose>
        <visual name="visual">
          <geometry><box><size>0.08 0.08 0.002</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
      <link name="cell_0_1">
        <pose>0 0.08 0.006 0 0 0</pose>
        <visual name="visual">
          <geometry><box><size>0.08 0.08 0.002</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
      <link name="cell_0_2">
        <pose>0.08 0.08 0.006 0 0 0</pose>
        <visual name="visual">
          <geometry><box><size>0.08 0.08 0.002</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
      <link name="cell_1_0">
        <pose>-0.08 0 0.006 0 0 0</pose>
        <visual name="visual">
          <geometry><box><size>0.08 0.08 0.002</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
      <link name="cell_1_1">
        <pose>0 0 0.006 0 0 0</pose>
        <visual name="visual">
          <geometry><box><size>0.08 0.08 0.002</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
      <link name="cell_1_2">
        <pose>0.08 0 0.006 0 0 0</pose>
        <visual name="visual">
          <geometry><box><size>0.08 0.08 0.002</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
      <link name="cell_2_0">
        <pose>-0.08 -0.08 0.006 0 0 0</pose>
        <visual name="visual">
          <geometry><box><size>0.08 0.08 0.002</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
      <link name="cell_2_1">
        <pose>0 -0.08 0.006 0 0 0</pose>
        <visual name="visual">
          <geometry><box><size>0.08 0.08 0.002</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
      <link name="cell_2_2">
        <pose>0.08 -0.08 0.006 0 0 0</pose>
        <visual name="visual">
          <geometry><box><size>0.08 0.08 0.002</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>

      <link name="v_line_1">
        <pose>-0.04 0 0.007 0 0 0</pose>
        <visual name="visual">
          <geometry><box><size>0.004 0.28 0.002</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
      <link name="v_line_2">
        <pose>0.04 0 0.007 0 0 0</pose>
        <visual name="visual">
          <geometry><box><size>0.004 0.28 0.002</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
      <link name="h_line_1">
        <pose>0 -0.04 0.007 0 0 0</pose>
        <visual name="visual">
          <geometry><box><size>0.28 0.004 0.002</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
      <link name="h_line_2">
        <pose>0 0.04 0.007 0 0 0</pose>
        <visual name="visual">
          <geometry><box><size>0.28 0.004 0.002</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 말(piece) 공급 위치: 로봇용(6~10)은 y=-0.2, 사람용(11~15)은 y=0.2.
         모두 +0.20m 만큼 같이 들어올림. model:// 경로는 GZ_SIM_RESOURCE_PATH에
         project2/models가 등록되어 있어야 풀린다 (launch 파일에서 처리). -->
    <include>
      <uri>model://aruco_cube_6</uri>
      <name>robot_cube_6</name>
      <pose>0.10 -0.2 0.245 0 0 0</pose>
    </include>
    <include>
      <uri>model://aruco_cube_7</uri>
      <name>robot_cube_7</name>
      <pose>0.15 -0.2 0.245 0 0 0</pose>
    </include>
    <include>
      <uri>model://aruco_cube_8</uri>
      <name>robot_cube_8</name>
      <pose>0.20 -0.2 0.245 0 0 0</pose>
    </include>
    <include>
      <uri>model://aruco_cube_9</uri>
      <name>robot_cube_9</name>
      <pose>0.25 -0.2 0.245 0 0 0</pose>
    </include>
    <include>
      <uri>model://aruco_cube_10</uri>
      <name>robot_cube_10</name>
      <pose>0.30 -0.2 0.245 0 0 0</pose>
    </include>
    <include>
      <uri>model://aruco_cube_11</uri>
      <name>human_cube_11</name>
      <pose>0.10 0.2 0.245 0 0 0</pose>
    </include>
    <include>
      <uri>model://aruco_cube_12</uri>
      <name>human_cube_12</name>
      <pose>0.15 0.2 0.245 0 0 0</pose>
    </include>
    <include>
      <uri>model://aruco_cube_13</uri>
      <name>human_cube_13</name>
      <pose>0.20 0.2 0.245 0 0 0</pose>
    </include>
    <include>
      <uri>model://aruco_cube_14</uri>
      <name>human_cube_14</name>
      <pose>0.25 0.2 0.245 0 0 0</pose>
    </include>
    <include>
      <uri>model://aruco_cube_15</uri>
      <name>human_cube_15</name>
      <pose>0.30 0.2 0.245 0 0 0</pose>
    </include>

    <!-- 보드를 수직으로 내려다보는 고정 카메라. referee 노드가 구독하는
         /camera/image_raw, /camera/camera_info 는 launch 파일에서 브릿지. -->
    <model name="overhead_camera">
      <static>true</static>
      <pose>0.3 0.0 0.65 0 1.5708 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
        <sensor name="camera" type="camera">
          <always_on>true</always_on>
          <update_rate>15</update_rate>
          <visualize>true</visualize>
          <topic>/camera/image_raw</topic>
          <camera>
            <horizontal_fov>1.05</horizontal_fov>
            <image><width>800</width><height>800</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>5.0</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

    <gui>
      <camera name="user_camera">
        <pose>1.0 0.8 0.9 0 0.4 -2.6</pose>
      </camera>
    </gui>
  </world>
</sdf>
